#!/bin/sh
#
# Pre-commit hook that runs detektFormat before each commit
#

echo "Running detekt formatting..."

export SDKMAN_DIR="$HOME/.sdkman"
# shellcheck source=/dev/null
[ -s "$SDKMAN_DIR/bin/sdkman-init.sh" ] && . "$SDKMAN_DIR/bin/sdkman-init.sh"
sdk use java 21.0.9-jbr

# Run the gradle task
./gradlew detektFormat --continue

# Check the exit code
if [ $? -ne 0 ]; then
    echo "Error: detektFormat failed. Commit aborted."
    exit 3
fi

echo "Formatting complete."
exit 0
